  {
    "id": "table.ruling",
    "label": "Create table ruling",
    "summary": "Creates table ruling with required columns",
    "operationClass": "additive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "ruling"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"ruling\" does not exist",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "ruling"
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"ruling\"",
        "sql": "CREATE TABLE \"ruling\" (\n  \"answer\" TEXT,\n  \"answerChoiceId\" TEXT,\n  \"context\" TEXT NOT NULL,\n  \"createdAt\" TEXT NOT NULL DEFAULT (datetime('now')),\n  \"id\" TEXT NOT NULL,\n  \"question\" TEXT NOT NULL,\n  \"radius\" TEXT NOT NULL,\n  \"requesterAgentId\" TEXT NOT NULL,\n  \"ruledAt\" TEXT,\n  \"ruledBy\" TEXT,\n  \"urgency\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\"),\n  FOREIGN KEY (\"requesterAgentId\") REFERENCES \"agent\" (\"id\") ON DELETE RESTRICT ON UPDATE RESTRICT,\n  FOREIGN KEY (\"answerChoiceId\") REFERENCES \"rulingChoice\" (\"id\") ON DELETE RESTRICT ON UPDATE RESTRICT\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"ruling\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "ruling"
        ]
      }
    ]
  },

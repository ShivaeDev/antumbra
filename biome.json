{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"markdown": {
		"parser": {
			"frontmatter": true
		}
	},
	"plugins": [
		{
			"path": "./script/lint/plugins/effect-boundaries.grit",
			"includes": ["**/*.ts", "**/*.tsx", "!**/*.d.ts", "!**/adapters/**"]
		},
		{
			"path": "./script/lint/plugins/imports.grit",
			"includes": ["**/*.ts", "**/*.tsx", "!**/*.d.ts"]
		}
	],
	"extends": ["@shivaedev/quality/biome/preset.json"]
}

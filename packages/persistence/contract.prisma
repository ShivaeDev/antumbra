// use prisma-next

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

model Intent {
  id        String   @id
  tag       String
  payload   String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

model Agent {
  id               String   @id
  role             String
  charter          String
  status           String
  currentSessionId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([status])
}

model Moorage {
  agentId      String   @id
  runner       String
  root         String
  status       String
  reclaimState String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([status])
}

model AgentSession {
  id                 String    @id
  agentId            String
  backend            String    @default("claude")
  cwd                String
  nativeRef          String?
  status             String
  executionStatus    String    @default("active")
  outcome            String?
  completeness       String    @default("recording")
  label              String?
  kind               String?
  parentSessionId    String?
  rootSessionId      String
  charterDeliveredAt DateTime?
  createdAt          DateTime  @default(now())
  parent             AgentSession?  @relation("SessionTree", fields: [parentSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children           AgentSession[] @relation("SessionTree")
  root               AgentSession   @relation("SessionRoot", fields: [rootSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nodes              AgentSession[] @relation("SessionRoot")
  events             SessionEvent[]
  inputs             SessionInput[]

  @@index([agentId])
  @@index([parentSessionId])
  @@index([rootSessionId, status])
}

model Berth {
  id         String    @id
  agentId    String
  runner     String
  source     String
  slug       String
  ref        String
  branch     String
  path       String
  status     String
  reclaimState String?
  strandedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([agentId])
  @@index([status])
}

model Repo {
  id         String   @id
  name       String
  source     String
  defaultRef String
  createdAt  DateTime @default(now())

  @@unique([source])
}

model SessionEvent {
  sessionId String
  seq       Int
  kind      String
  payload   String
  at        DateTime @default(now())
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([sessionId, seq])
}

model SessionInput {
  id             String   @id
  sessionId      String
  requestDigest  String
  deliveryStatus String
  createdAt      DateTime @default(now())
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parts          SessionInputPart[]

  @@index([sessionId, createdAt])
}

model SessionAttachment {
  id        String   @id
  digest    String   @unique
  mediaType String
  byteSize  Int
  width     Int
  height    Int
  createdAt DateTime @default(now())
  parts     SessionInputPart[]
}

model SessionInputPart {
  inputId      String
  position     Int
  kind         String
  text         String?
  attachmentId String?
  displayName  String?
  input        SessionInput @relation(fields: [inputId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachment   SessionAttachment? @relation(fields: [attachmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([inputId, position])
  @@index([attachmentId])
}

model Voyage {
  id        String    @id
  name      String
  northStar String
  context   String
  focusedAt DateTime?
  backend   String
  createdAt DateTime  @default(now())
}

model Piece {
  id          String    @id
  title       String
  charter     String
  expectation String
  role        String
  launchedAt  DateTime?
  parkedAt    DateTime?
  createdAt   DateTime  @default(now())
  reports     PieceReport[]
  artifacts   Artifact[]
}

model VoyagePiece {
  voyageId  String
  pieceId   String
  createdAt DateTime @default(now())

  @@id([voyageId, pieceId])
  @@index([pieceId])
}

model PieceEdge {
  fromPieceId String
  toPieceId   String

  @@id([fromPieceId, toPieceId])
  @@index([toPieceId])
}

model PieceAgent {
  pieceId    String
  agentId    String
  assignedAt DateTime @default(now())

  @@id([pieceId, agentId])
  @@index([agentId])
}

model VoyageAgent {
  voyageId String
  agentId  String
  role     String

  @@id([voyageId, agentId])
  @@index([agentId])
}

model Report {
  id            String   @id
  authorAgentId String?
  title         String
  body          String
  createdAt     DateTime @default(now())
  pieces        PieceReport[]
}

model Artifact {
  id                     String   @id
  pieceId                String
  supersededByArtifactId String?  @unique
  authorAgentId          String?
  title                  String
  digest                 String
  byteSize               Int
  basename               String
  createdAt              DateTime @default(now())
  piece                  Piece     @relation(fields: [pieceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy           Artifact? @relation("ArtifactSupersession", fields: [supersededByArtifactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes             Artifact[] @relation("ArtifactSupersession")

  @@index([pieceId])
}

model PieceReport {
  pieceId  String
  reportId String
  piece    Piece  @relation(fields: [pieceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  report   Report @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([pieceId, reportId])
}

model Change {
  id              String    @id
  repoId          String
  host            String
  title           String
  body            String
  headRef         String
  baseRef         String
  headSha         String?
  preparedHeadRef String?
  preparedHeadSha String?
  proposalFrozenAt DateTime?
  worktreePath    String?
  workingDiff     String?
  workingTreeStatus String?
  submissionKey   String?   @unique
  stage           String
  draftAt         DateTime?
  url             String?
  externalId      String?
  checks          String
  review          String
  mergeable       String
  openedByAgentId String?
  originSessionId String?
  raw             String?
  activityAt      DateTime
  observedAt      DateTime
  landedAt        DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([repoId])
  @@index([host, externalId])
  @@unique([host, repoId, externalId])
}

model ChangeTransition {
  id         String   @id
  changeId   String
  fromStage  String
  toStage    String
  activityAt DateTime
  observedAt DateTime

  @@index([changeId, activityAt])
}

model PieceChange {
  pieceId  String
  changeId String
  purpose  String @default("produces")

  @@id([pieceId, changeId])
  @@index([changeId])
}

model Board {
  id        String   @id
  createdAt DateTime @default(now())
}

model BoardEntry {
  id            String   @id
  boardId       String
  seq           Int
  kind          String   @default("note")
  precedence    String   @default("routine")
  sourceRef     String?
  register      String
  authorAgentId String?
  body          String
  createdAt     DateTime @default(now())

  @@index([boardId])
  @@unique([boardId, seq])
  @@unique([boardId, sourceRef])
}

model BoardEntryReceipt {
  entryId String   @id
  readAt  DateTime @default(now())
}

model BoardOwner {
  boardId   String @id
  ownerKind String
  ownerId   String

  @@unique([ownerKind, ownerId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

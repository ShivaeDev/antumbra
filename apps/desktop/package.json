		"@antumbra/domain-backends": "workspace:*",
		"@antumbra/contract": "workspace:*",
		"@antumbra/domain": "workspace:*",
		"@antumbra/domain-feeds": "workspace:*",
		"@antumbra/github": "workspace:*",

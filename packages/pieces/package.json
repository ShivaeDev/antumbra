{
	"name": "@antumbra/pieces",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"imports": {
		"#test/*": "./test/*",
		"#*": "./src/*"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"typecheck:compat": "tsc6 --noEmit"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@antumbra/domain-feeds": "workspace:*",
		"@antumbra/persistence": "workspace:*",
		"@antumbra/platform-vocabulary": "workspace:*",
		"effect": "catalog:",
		"@antumbra/voyages": "workspace:*"
	}
}

// use prisma-next

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("app_meta")
}

model Intent {
  id           String   @id
  tag          String
  payload      String
  status       String
  detail       String?
  resumePolicy String   @map("resume_policy")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@map("intent")
}

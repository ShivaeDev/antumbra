{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"resolveJsonModule": true
	},
	"include": [
		"script",
		"apps/*/script",
		"apps/*/src",
		"apps/*/test",
		"packages/*/script",
		"packages/*/src",
		"packages/*/test",
		"packages/*/*/script",
		"packages/*/*/src",
		"packages/*/*/test",
		"packages/*/*/*/src",
		"packages/*/*/*/test"
	],
	"exclude": ["packages/platform/service-definition/test"]
}

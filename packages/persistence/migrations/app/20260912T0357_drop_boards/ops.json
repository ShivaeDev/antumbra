[
  {
    "id": "dropTable.board",
    "label": "Drop table board",
    "summary": "Drops table board which is not in the contract",
    "operationClass": "destructive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "board"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"board\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "board"
        ]
      }
    ],
    "execute": [
      {
        "description": "drop table \"board\"",
        "sql": "DROP TABLE \"board\""
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"board\" is gone",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "board"
        ]
      }
    ]
  },

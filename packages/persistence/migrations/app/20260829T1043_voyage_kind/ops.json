[
  {
    "id": "column.voyage.kind",
    "label": "Add column kind on voyage",
    "summary": "Adds column kind on voyage",
    "operationClass": "additive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "column",
        "name": "kind",
        "table": "voyage"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"kind\" is missing",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM pragma_table_info(?) WHERE \"name\" = ?",
        "params": [
          "voyage",
          "kind"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"kind\"",
        "sql": "ALTER TABLE \"voyage\" ADD COLUMN \"kind\" TEXT DEFAULT 'voyage' NOT NULL"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"kind\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM pragma_table_info(?) WHERE \"name\" = ?",
        "params": [
          "voyage",
          "kind"
        ]
      }
    ]
  }
]
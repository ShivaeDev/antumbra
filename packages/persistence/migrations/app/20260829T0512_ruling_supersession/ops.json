  {
    "id": "recreateTable.ruling",
    "label": "Recreate table ruling",
    "summary": "Recreates table ruling to apply schema changes: database/ruling/foreign-key:supersededById->.ruling(id)",
    "operationClass": "destructive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "ruling"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"ruling\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "ruling"
        ]
      },
      {
        "description": "ensure temp table \"_prisma_new_ruling\" does not exist",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "_prisma_new_ruling"
        ]
      }
    ],
    "execute": [
      {
        "description": "create new table \"_prisma_new_ruling\" with desired schema",
        "sql": "CREATE TABLE \"_prisma_new_ruling\" (\n  \"answer\" TEXT,\n  \"answerChoiceId\" TEXT,\n  \"context\" TEXT NOT NULL,\n  \"createdAt\" TEXT DEFAULT (datetime('now')) NOT NULL,\n  \"deliveredAt\" TEXT,\n  \"id\" TEXT NOT NULL,\n  \"question\" TEXT NOT NULL,\n  \"radius\" TEXT NOT NULL,\n  \"requesterAgentId\" TEXT NOT NULL,\n  \"ruledAt\" TEXT,\n  \"ruledBy\" TEXT,\n  \"supersededAt\" TEXT,\n  \"supersededBy\" TEXT,\n  \"supersededById\" TEXT,\n  \"urgency\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\"),\n  FOREIGN KEY (\"requesterAgentId\") REFERENCES \"agent\" (\"id\") ON DELETE RESTRICT ON UPDATE RESTRICT,\n  FOREIGN KEY (\"answerChoiceId\") REFERENCES \"rulingChoice\" (\"id\") ON DELETE RESTRICT ON UPDATE RESTRICT,\n  FOREIGN KEY (\"supersededById\") REFERENCES \"ruling\" (\"id\") ON DELETE RESTRICT ON UPDATE RESTRICT\n)"
      },
      {
        "description": "copy data from \"ruling\" to \"_prisma_new_ruling\"",
        "sql": "INSERT INTO \"_prisma_new_ruling\" (\"answer\", \"answerChoiceId\", \"context\", \"createdAt\", \"deliveredAt\", \"id\", \"question\", \"radius\", \"requesterAgentId\", \"ruledAt\", \"ruledBy\", \"urgency\") SELECT \"answer\", \"answerChoiceId\", \"context\", \"createdAt\", \"deliveredAt\", \"id\", \"question\", \"radius\", \"requesterAgentId\", \"ruledAt\", \"ruledBy\", \"urgency\" FROM \"ruling\""
      },
      {
        "description": "drop old table \"ruling\"",
        "sql": "DROP TABLE \"ruling\""
      },
      {
        "description": "rename \"_prisma_new_ruling\" to \"ruling\"",
        "sql": "ALTER TABLE \"_prisma_new_ruling\" RENAME TO \"ruling\""
      },
      {
        "description": "recreate index \"ruling_ruledAt_idx\" on \"ruling\"",
        "sql": "CREATE INDEX \"ruling_ruledAt_idx\" ON \"ruling\" (\"ruledAt\")"
      },
      {
        "description": "recreate index \"ruling_supersededById_idx\" on \"ruling\"",
        "sql": "CREATE INDEX \"ruling_supersededById_idx\" ON \"ruling\" (\"supersededById\")"
      },
      {
        "description": "recreate index \"ruling_requesterAgentId_idx\" on \"ruling\"",
        "sql": "CREATE INDEX \"ruling_requesterAgentId_idx\" ON \"ruling\" (\"requesterAgentId\")"
      },
      {
        "description": "recreate index \"ruling_answerChoiceId_idx\" on \"ruling\"",
        "sql": "CREATE INDEX \"ruling_answerChoiceId_idx\" ON \"ruling\" (\"answerChoiceId\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"ruling\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "ruling"
        ]
      },
      {
        "description": "verify temp table \"_prisma_new_ruling\" is gone",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "_prisma_new_ruling"
        ]
      },
      {
        "description": "verify foreign key (requesterAgentId) → agent(id) on \"ruling\"",
        "sql": "SELECT EXISTS (SELECT 1 FROM pragma_foreign_key_list('ruling') f WHERE f.\"table\" = 'agent' GROUP BY f.id HAVING COUNT(*) = 1 AND SUM(CASE WHEN (f.\"from\", f.\"to\") IN (('requesterAgentId', 'id')) THEN 1 ELSE 0 END) = 1)"
      },
      {
        "description": "verify foreign key (answerChoiceId) → rulingChoice(id) on \"ruling\"",
        "sql": "SELECT EXISTS (SELECT 1 FROM pragma_foreign_key_list('ruling') f WHERE f.\"table\" = 'rulingChoice' GROUP BY f.id HAVING COUNT(*) = 1 AND SUM(CASE WHEN (f.\"from\", f.\"to\") IN (('answerChoiceId', 'id')) THEN 1 ELSE 0 END) = 1)"
      },
      {
        "description": "verify foreign key (supersededById) → ruling(id) on \"ruling\"",
        "sql": "SELECT EXISTS (SELECT 1 FROM pragma_foreign_key_list('ruling') f WHERE f.\"table\" = 'ruling' GROUP BY f.id HAVING COUNT(*) = 1 AND SUM(CASE WHEN (f.\"from\", f.\"to\") IN (('supersededById', 'id')) THEN 1 ELSE 0 END) = 1)"
      }
    ]
  }

// use prisma-next

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

model Intent {
  id        String   @id
  tag       String
  payload   String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

model Agent {
  id        String   @id
  role      String
  charter   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

model AgentSession {
  id                 String    @id
  agentId            String
  backend            String    @default("claude")
  cwd                String
  nativeRef          String?
  status             String
  charterDeliveredAt DateTime?
  createdAt          DateTime  @default(now())

  @@index([agentId])
}

model Berth {
  id         String    @id
  agentId    String
  runner     String
  source     String
  slug       String
  ref        String
  branch     String
  path       String
  status     String
  strandedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([agentId])
  @@index([status])
}

model Repo {
  id         String   @id
  name       String
  source     String
  defaultRef String
  createdAt  DateTime @default(now())

  @@unique([source])
}

model SessionEvent {
  sessionId String
  seq       Int
  kind      String
  payload   String
  at        DateTime @default(now())

  @@id([sessionId, seq])
}

model Voyage {
  id        String    @id
  name      String
  northStar String
  context   String
  focusedAt DateTime?
  backend   String
  createdAt DateTime  @default(now())
}

model Piece {
  id          String    @id
  title       String
  charter     String
  expectation String
  role        String
  launchedAt  DateTime?
  parkedAt    DateTime?
  createdAt   DateTime  @default(now())
}

model VoyagePiece {
  voyageId  String
  pieceId   String
  createdAt DateTime @default(now())

  @@id([voyageId, pieceId])
  @@index([pieceId])
}

model PieceEdge {
  fromPieceId String
  toPieceId   String

  @@id([fromPieceId, toPieceId])
  @@index([toPieceId])
}

model PieceAgent {
  pieceId    String
  agentId    String
  assignedAt DateTime @default(now())

  @@id([pieceId, agentId])
  @@index([agentId])
}

model VoyageAgent {
  voyageId String
  agentId  String
  role     String

  @@id([voyageId, agentId])
  @@index([agentId])
}

model Report {
  id            String   @id
  authorAgentId String?
  title         String
  body          String
  createdAt     DateTime @default(now())
}

model Artifact {
  id            String   @id
  authorAgentId String?
  title         String
  uri           String
  createdAt     DateTime @default(now())
}

model PieceReport {
  pieceId  String
  reportId String

  @@id([pieceId, reportId])
}

model PieceArtifact {
  pieceId    String
  artifactId String

  @@id([pieceId, artifactId])
}

model Board {
  id        String   @id
  createdAt DateTime @default(now())
}

model BoardEntry {
  id            String   @id
  boardId       String
  register      String
  authorAgentId String?
  body          String
  createdAt     DateTime @default(now())

  @@index([boardId])
}

model VoyageBoard {
  voyageId String
  boardId  String

  @@id([voyageId, boardId])
}

model PieceBoard {
  pieceId String
  boardId String

  @@id([pieceId, boardId])
}

model AgentBoard {
  agentId String
  boardId String

  @@id([agentId, boardId])
}

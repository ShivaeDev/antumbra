{
	"name": "@antumbra/workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#*": "./script/*"
	},
	"scripts": {
		"build": "pnpm --recursive --if-present build",
		"check": "biome check . && prettier --check \"**/*.md\"",
		"format": "biome check --write . && prettier --write \"**/*.md\"",
		"lint": "pnpm check && node script/lint.ts && pnpm lint:boundaries",
		"lint:boundaries": "node script/boundaries.ts",
		"test": "pnpm test:packages && pnpm test:desktop && pnpm test:runner-local",
		"test:desktop": "pnpm --filter @antumbra/desktop test",
		"test:guards": "vitest run --dir script",
		"test:packages": "vitest run --config script/vitest.workspace.ts",
		"test:runner-local": "pnpm --filter @antumbra/runner-local test",
		"typecheck": "pnpm --recursive --if-present typecheck",
		"typecheck:compat": "pnpm --recursive --if-present typecheck:compat",
		"typecheck:root": "tsc --noEmit",
		"typecheck:workspace": "tsc --noEmit -p tsconfig.workspace.json",
		"ready": "node script/ready.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"dependency-cruiser": "catalog:",
		"effect": "catalog:",
		"ignore": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

  {
    "id": "voyage.backend.split",
    "label": "Seat both backends where one sailed",
    "summary": "copy the voyage backend onto the captain and the crew alike",
    "operationClass": "data",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "voyage"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "copy the voyage backend onto the captain and the crew alike",
        "sql": "UPDATE \"voyage\"\nSET \"captainBackend\" = \"backend\", \"crewBackend\" = \"backend\""
      }
    ],
    "postcheck": []
  },
  {
    "id": "recreateTable.voyage",
    "label": "Recreate table voyage",
    "summary": "Recreates table voyage to require both backends and drop column backend",
    "operationClass": "destructive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "voyage"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"voyage\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "voyage"
        ]
      },
      {
        "description": "ensure temp table \"_prisma_new_voyage\" does not exist",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "_prisma_new_voyage"
        ]
      }
    ],
    "execute": [
      {
        "description": "create new table \"_prisma_new_voyage\" with desired schema",
        "sql": "CREATE TABLE \"_prisma_new_voyage\" (\n  \"captainBackend\" TEXT NOT NULL,\n  \"context\" TEXT NOT NULL,\n  \"createdAt\" TEXT DEFAULT (datetime('now')) NOT NULL,\n  \"crewBackend\" TEXT NOT NULL,\n  \"focusedAt\" TEXT,\n  \"id\" TEXT NOT NULL,\n  \"kind\" TEXT DEFAULT 'voyage' NOT NULL,\n  \"name\" TEXT NOT NULL,\n  \"northStar\" TEXT NOT NULL,\n  PRIMARY KEY (\"id\")\n)"
      },
      {
        "description": "copy data from \"voyage\" to \"_prisma_new_voyage\"",
        "sql": "INSERT INTO \"_prisma_new_voyage\" (\"captainBackend\", \"context\", \"createdAt\", \"crewBackend\", \"focusedAt\", \"id\", \"kind\", \"name\", \"northStar\") SELECT \"captainBackend\", \"context\", \"createdAt\", \"crewBackend\", \"focusedAt\", \"id\", \"kind\", \"name\", \"northStar\" FROM \"voyage\""
      },
      {
        "description": "drop old table \"voyage\"",
        "sql": "DROP TABLE \"voyage\""
      },
      {
        "description": "rename \"_prisma_new_voyage\" to \"voyage\"",
        "sql": "ALTER TABLE \"_prisma_new_voyage\" RENAME TO \"voyage\""
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"voyage\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "voyage"
        ]
      },
      {
        "description": "verify temp table \"_prisma_new_voyage\" is gone",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM \"sqlite_master\" WHERE (\"type\" = ? AND \"name\" = ?)",
        "params": [
          "table",
          "_prisma_new_voyage"
        ]
      },
      {
        "description": "verify column \"backend\" is gone from \"voyage\"",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM pragma_table_info('voyage') WHERE \"name\" = 'backend'"
      }
    ]
  }
]
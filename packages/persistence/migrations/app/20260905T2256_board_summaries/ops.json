  {
    "id": "data.boardEntry.roughenAgentNotes",
    "label": "Move agent-written notes to the rough register",
    "summary": "the smooth register now holds summaries and what the admiral wrote, so notes an agent left fold under a summary instead",
    "operationClass": "data",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "table",
        "name": "boardEntry"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "the smooth register now holds summaries and what the admiral wrote, so notes an agent left fold under a summary instead",
        "sql": "UPDATE \"boardEntry\"\n              SET \"register\" = 'rough'\n            WHERE \"register\" = 'smooth' AND \"kind\" = 'note' AND \"authorAgentId\" IS NOT NULL"
      }
    ],
    "postcheck": []
  }

{
	"name": "@antumbra/desktop",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#package.json": "./package.json",
		"#script/*": "./script/*",
		"#test/*": "./test/*",
		"#*": "./src/*"
	},
	"main": "out/main.js",
	"scripts": {
		"build": "node script/build.ts",
		"dev": "install-electron && node script/dev.ts",
		"package": "node script/build.ts && electron-builder --mac --publish never",
		"pretest": "install-electron",
		"test": "node ../../script/test.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:compat": "tsc6 --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@antumbra/domain-agents": "workspace:*",
		"@antumbra/glass-client": "workspace:*",
		"@antumbra/glass-components": "workspace:*",
		"@antumbra/glass-renderer": "workspace:*",
		"@antumbra/platform-access": "workspace:*",
		"@antumbra/platform-feature": "workspace:*",
		"@antumbra/platform-runner": "workspace:*",
		"@antumbra/platform-shell": "workspace:*",
		"@antumbra/platform-vocabulary": "workspace:*",
		"@antumbra/server": "workspace:*",
		"@antumbra/server-agents": "workspace:*",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@effect/platform-node": "catalog:",
		"@shivaedev/contract": "catalog:",
		"@shivaedev/form": "catalog:",
		"@shivaedev/react": "catalog:",
		"@shivaedev/server": "catalog:",
		"sharp": "catalog:"
	},
	"devDependencies": {
		"@antumbra/app-testing": "workspace:*",
		"@antumbra/domain-backends": "workspace:*",
		"@antumbra/domain-boards": "workspace:*",
		"@antumbra/domain-pieces": "workspace:*",
		"@antumbra/domain-role-settings": "workspace:*",
		"@antumbra/domain-settings": "workspace:*",
		"@antumbra/domain-voyages": "workspace:*",
		"@antumbra/platform-skills": "workspace:*",
		"@antumbra/runner": "workspace:*",
		"@effect/vitest": "catalog:",
		"@electron/asar": "catalog:",
		"@shivaedev/test-story": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"effect": "catalog:",
		"electron": "catalog:",
		"electron-builder": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"rolldown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}

{
	"name": "@antumbra/workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
	"engines": {
		"node": "26.10.0"
	},
	"imports": {
		"#*": "./script/*"
	},
	"scripts": {
		"build": "pnpm --recursive --no-sort --if-present build",
		"check": "biome check . --reporter=concise --max-diagnostics=none && prettier --check \"**/*.md\"",
		"format": "biome check --write . && prettier --write \"**/*.md\"",
		"lint": "pnpm check && node script/lint.ts && pnpm lint:boundaries",
		"lint:boundaries": "node script/boundaries.ts",
		"test": "pnpm test:packages && pnpm test:desktop && pnpm test:runner && pnpm test:server && pnpm test:app",
		"test:desktop": "pnpm --filter @antumbra/desktop test",
		"test:guards": "node script/test.ts --dir script",
		"test:packages": "node script/test.ts --config script/vitest.workspace.ts",
		"test:server": "pnpm --filter @antumbra/server test",
		"typecheck": "pnpm --recursive --no-sort --workspace-concurrency=1 --if-present typecheck",
		"typecheck:shard": "node script/typecheck.ts",
		"typecheck:compat": "pnpm --recursive --no-sort --workspace-concurrency=1 --if-present typecheck:compat",
		"typecheck:compat:workspace": "tsc6 --noEmit -p tsconfig.workspace.json",
		"typecheck:root": "tsc --noEmit",
		"typecheck:workspace": "tsc --noEmit -p tsconfig.workspace.json",
		"journal": "node script/journal.ts",
		"fixture": "node script/fixture.ts",
		"flakes": "node script/flakes.ts",
		"pr": "node script/pr.ts",
		"ready": "node script/ready.ts",
		"wt": "node script/wt.ts",
		"test:runner": "pnpm --filter @antumbra/runner test",
		"test:app": "pnpm --filter @antumbra/app-testing test",
		"setup": "pnpm install --frozen-lockfile"
	},
	"devDependencies": {
		"@antumbra/platform-feature": "workspace:*",
		"@antumbra/server": "workspace:*",
		"@antumbra/server-journal": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"@types/proper-lockfile": "catalog:",
		"@typescript/native": "catalog:",
		"dependency-cruiser": "catalog:",
		"effect": "catalog:",
		"ignore": "catalog:",
		"prettier": "catalog:",
		"proper-lockfile": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}

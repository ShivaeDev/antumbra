{
	"name": "@antumbra/persistence",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"imports": {
		"#contract.d.ts": "./contract.d.ts",
		"#contract.json": "./contract.json",
		"#test/*": "./test/*",
		"#*": "./src/*"
	},
	"scripts": {
		"contract:emit": "prisma-next contract emit --no-interactive",
		"contract:plan": "prisma-next migration plan --no-interactive",
		"test": "node ../../script/test.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:compat": "tsc6 --noEmit"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@prisma-next/cli": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@prisma-next/adapter-sqlite": "catalog:",
		"@prisma-next/contract": "catalog:",
		"@prisma-next/sql-contract": "catalog:",
		"@prisma-next/sqlite": "catalog:",
		"@shivaedev/effect-prisma": "catalog:",
		"effect": "catalog:"
	}
}

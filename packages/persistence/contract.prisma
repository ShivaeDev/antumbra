// use prisma-next

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

model Intent {
  id        String   @id
  tag       String
  payload   String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

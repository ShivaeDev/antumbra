// use prisma-next

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

model Intent {
  id        String   @id
  tag       String
  payload   String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

model Agent {
  id        String   @id
  role      String
  charter   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([status])
}

model AgentSession {
  id                 String    @id
  agentId            String
  backend            String    @default("claude")
  cwd                String
  nativeRef          String?
  status             String
  charterDeliveredAt DateTime?
  createdAt          DateTime  @default(now())

  @@index([agentId])
}

model Berth {
  id         String    @id
  agentId    String
  runner     String
  source     String
  slug       String
  ref        String
  branch     String
  path       String
  status     String
  strandedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  @@index([agentId])
  @@index([status])
}

model Repo {
  id         String   @id
  name       String
  source     String
  defaultRef String
  createdAt  DateTime @default(now())

  @@unique([source])
}

model SessionEvent {
  sessionId String
  seq       Int
  kind      String
  payload   String
  at        DateTime @default(now())

  @@id([sessionId, seq])
}
